FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN corepack enable && pnpm install --frozen-lockfile && pnpm store prune
COPY src ./src
RUN node_modules/.bin/esbuild src/providers/container-browser/worker.ts src/providers/container-browser/bridge.ts --bundle --platform=node --format=esm --outdir=/out --out-extension:.js=.mjs \
    && agent="node_modules/agent-browser/bin/agent-browser-linux-$(node -p process.arch)" \
    && install -D -m 555 "$agent" "/out/$agent" \
    && install -D -m 555 src/providers/container-browser/chromium.sh /out/src/providers/container-browser/chromium.sh \
    && install -D -m 555 src/providers/container-browser/chrome.sh /out/src/providers/container-browser/chrome.sh

FROM node:24.21.0-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS browser
ARG NOD_RUNTIME_REFRESH
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb xauth xdotool ffmpeg fonts-liberation fonts-noto-core fonts-noto-cjk fonts-noto-color-emoji ca-certificates \
    && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      node -e "fetch('https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb').then(async (r) => { if (!r.ok) throw new Error('Google Chrome download failed with HTTP ' + r.status); require('node:fs').writeFileSync('/tmp/google-chrome.deb', Buffer.from(await r.arrayBuffer())); })" \
      && apt-get install -y --no-install-recommends /tmp/google-chrome.deb && rm /tmp/google-chrome.deb; \
    else apt-get install -y --no-install-recommends chromium; fi \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out ./
COPY --chmod=555 src/providers/container-browser/xvfb.sh /usr/local/bin/Xvfb
RUN mkdir /data && chown node:node /data && chmod 700 /data
USER node
CMD ["node", "/app/worker.mjs"]

FROM browser AS eval
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules

FROM browser
